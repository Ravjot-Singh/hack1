// Scheduling Optimizer data model. Every tenant-owned row carries institutionId.
// Flexible, solver-shaped settings (grids, rules, preferences) are stored as JSON and
// typed by src/lib/solver/types.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkloadMode {
  LTP
  HOURS
}

enum VersionStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model Institution {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  /// string[] e.g. ["Mon", ..., "Sat"]
  days           Json
  /// {start, end}[] shared bell schedule
  periods        Json
  passingMinutes Int      @default(5)
  /// RuleSettings
  rules          Json
  isDemo         Boolean  @default(false)
  /// Teaching term; dates outside it have no classes.
  termStart      DateTime? @db.Date
  termEnd        DateTime? @db.Date
  createdAt      DateTime @default(now())

  departments Department[]
  buildings   Building[]
  rooms       Room[]
  grids       TimeGrid[]
  teachers    Teacher[]
  programs    Program[]
  sections    Section[]
  subjects    Subject[]
  offerings   Offering[]
  baskets     ElectiveBasket[]
  versions    TimetableVersion[]
  shareLinks  ShareLink[]
  members     Membership[]
  invites     Invite[]
  calendar    CalendarDay[]
  absences    Absence[]
  covers      Cover[]
  notifications Notification[]
  aiCalls       AiCall[]
  bookings      VenueBooking[]
  officeHours   OfficeHours[]
  appointments  Appointment[]
  drives        PlacementDrive[]
  electiveWindows ElectiveWindow[]
  electiveChoices ElectiveChoice[]
  downtimes     RoomDowntime[]
  roomMoves     RoomMove[]
}

model Department {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  code          String

  rooms    Room[]
  teachers Teacher[]
  programs Program[]
  sections Section[]
  subjects Subject[]
  members  Membership[]
  invites  Invite[]
  signoffs DeptSignoff[]

  @@unique([institutionId, code])
}

model Building {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  /// Record<buildingId, minutes>
  travelMinutes Json        @default("{}")
  rooms         Room[]
}

model Room {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  type          String
  capacity      Int
  buildingId    String?
  building      Building?   @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  ownerDeptId   String?
  ownerDept     Department? @relation(fields: [ownerDeptId], references: [id], onDelete: SetNull)
  isEventVenue  Boolean     @default(false)
  bookings      VenueBooking[]
  downtimes     RoomDowntime[]
}

model TimeGrid {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  /// boolean[day][period]
  open          Json
  sections      Section[]
}

model Program {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name          String
  workloadMode  WorkloadMode @default(LTP)
  sections      Section[]

  @@unique([institutionId, name])
}

model Section {
  id            String           @id @default(cuid())
  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programId     String
  program       Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  gridId        String
  grid          TimeGrid         @relation(fields: [gridId], references: [id])
  year          Int
  name          String
  size          Int
  batches       Batch[]
  offerings     Offering[]       @relation("OfferingSections")
  baskets       ElectiveBasket[]
}

model Batch {
  id        String  @id @default(cuid())
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name      String
  size      Int
}

model Teacher {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  designation   String
  maxPerDay     Int
  maxPerWeek    Int
  /// [day, period][]
  unavailable   Json        @default("[]")
  /// SlotPref[]
  prefs         Json        @default("[]")
  offerings     Offering[]  @relation("OfferingTeachers")
  labOfferings  Offering[]  @relation("OfferingLabTeachers")
}

model Subject {
  id             String       @id @default(cuid())
  institutionId  String
  institution    Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  code           String
  name           String
  mode           WorkloadMode @default(LTP)
  L              Int          @default(0)
  T              Int          @default(0)
  P              Int          @default(0)
  hoursPerWeek   Int          @default(0)
  theoryRoomType String       @default("Classroom")
  labRoomType    String       @default("Classroom")
  labBlockLen    Int          @default(2)
  offerings      Offering[]

  @@unique([institutionId, code])
}

model ElectiveBasket {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  sections      Section[]
  offerings     Offering[]
  window        ElectiveWindow?
  choices       ElectiveChoice[]
}

model Offering {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sections      Section[]       @relation("OfferingSections")
  teachers      Teacher[]       @relation("OfferingTeachers")
  labTeachers   Teacher[]       @relation("OfferingLabTeachers")
  batchwiseLab  Boolean         @default(true)
  /// Share lab batches between the lab teachers instead of all of them teaching every batch.
  splitLabBatches Boolean       @default(false)
  basketId      String?
  basket        ElectiveBasket? @relation(fields: [basketId], references: [id], onDelete: SetNull)
  expectedSize  Int?
}

model TimetableVersion {
  id            String        @id @default(cuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  status        VersionStatus @default(DRAFT)
  quality       Int
  /// ScoreBreakdown + solve stats
  stats         Json
  /// InstituteInput snapshot the version was solved from, so it always renders consistently.
  snapshot      Json
  createdAt     DateTime      @default(now())
  submittedAt   DateTime?
  publishedAt   DateTime?
  /// User id of whoever published it.
  publishedBy   String?
  placements    Placement[]
  shareLinks    ShareLink[]
  signoffs      DeptSignoff[]
}

model Placement {
  id        String           @id @default(cuid())
  versionId String
  version   TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  lessonId  String
  day       Int
  period    Int
  roomId    String
  pinned    Boolean          @default(false)

  @@unique([versionId, lessonId])
  @@index([versionId, roomId])
}

/// Public read-only link to a timetable (no login). `view`/`entityId` null = the whole college.
model ShareLink {
  id            String           @id @default(cuid())
  token         String           @unique
  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  /// Null = always show the institute's latest published timetable.
  versionId     String?
  version       TimetableVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// "section" | "teacher" | "room"
  view          String?
  entityId      String?
  /// Who made the link (user id); they, an admin or the Head of Institute may revoke it.
  createdBy     String?
  createdAt     DateTime         @default(now())

  @@index([versionId])
}

// ---------------------------------------------------------------- Accounts (Better Auth core tables)

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Better Auth's sign-in/sign-up rate limits, kept in the database so they hold across
/// serverless instances (memory storage resets per instance).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// ---------------------------------------------------------------- Roles & workflow

enum Role {
  INSTITUTE_ADMIN
  HEAD_OF_INSTITUTE
  HOD
  TEACHER
  STUDENT
  PLACEMENT_OFFICER
  VENUE_MANAGER
  LAB_ASSISTANT
}

/// A user's role in one institute. HOD links a department, TEACHER a teacher record, STUDENT a section.
model Membership {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  role          Role
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teacherId     String?
  sectionId     String?
  createdAt     DateTime    @default(now())

  @@unique([userId, institutionId])
  @@index([institutionId])
}

/// Invite link for one person; accepted by signing up or in with any email.
model Invite {
  id            String      @id @default(cuid())
  token         String      @unique
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  role          Role
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teacherId     String?
  sectionId     String?
  invitedBy     String
  createdAt     DateTime    @default(now())
  expiresAt     DateTime
  /// When the link was last handed out (copied, shared or exported); null = never sent.
  sentAt        DateTime?
  acceptedAt    DateTime?
  acceptedBy    String?

  @@index([institutionId])
}

enum SignoffStatus {
  APPROVED
  CHANGES_REQUESTED
}

/// An HOD's review of a timetable version for their department.
model DeptSignoff {
  id           String           @id @default(cuid())
  versionId    String
  version      TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  status       SignoffStatus
  comment      String?
  userId       String
  createdAt    DateTime         @default(now())

  @@unique([versionId, departmentId])
}

// ---------------------------------------------------------------- Academic calendar

enum CalendarKind {
  HOLIDAY
  EXAM
  /// Classes run but follow another weekday's timetable (e.g. Saturday follows Monday).
  FOLLOWS
}

model CalendarDay {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  date          DateTime     @db.Date
  kind          CalendarKind
  label         String
  /// For FOLLOWS: index into the institute's days array.
  followsDay    Int?

  @@unique([institutionId, date])
}

// ---------------------------------------------------------------- Absences, substitutions, notifications

/// A teacher away on a date: whole day (periods = []) or specific periods (0-based).
model Absence {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teacherId     String
  date          DateTime    @db.Date
  periods       Json        @default("[]")
  reason        String?
  createdBy     String
  createdAt     DateTime    @default(now())

  @@unique([institutionId, teacherId, date])
  @@index([institutionId, date])
}

enum CoverAction {
  SUBSTITUTE
  CANCEL
}

/// What happens to one class of the published timetable on one date.
model Cover {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  date          DateTime    @db.Date
  versionId     String
  lessonId      String
  action        CoverAction
  substituteId  String?
  note          String?
  createdBy     String
  createdAt     DateTime    @default(now())

  @@unique([institutionId, date, lessonId])
  @@index([institutionId, date])
}

/// In-app message for one user (substitutions, cancellations, ...).
model Notification {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userId        String
  text          String
  link          String?
  createdAt     DateTime    @default(now())
  readAt        DateTime?

  @@index([userId, readAt])
}

// ---------------------------------------------------------------- Plain-English rules

/// One request to the AI fallback that reads plain-English rules. Doubles as the cache:
/// the same sentence in the same college is answered from here without a new call.
model AiCall {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  provider      String
  model         String
  /// The sentence, lower-cased with whitespace collapsed (the cache key).
  input         String
  /// Names-based answer from the model; null when the call failed.
  output        Json?
  error         String?
  inputTokens   Int?
  outputTokens  Int?
  userId        String?
  createdAt     DateTime    @default(now())

  @@index([institutionId, input])
}

// ---------------------------------------------------------------- Venue booking

enum BookingPriority {
  INSTITUTE
  PLACEMENT
  DEPARTMENT
  CLUB
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A request to use a room on one date for a run of periods (event venues any time,
/// other rooms only when free of classes unless the Head of Institute overrides).
model VenueBooking {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date          DateTime        @db.Date
  /// 0-based periods, inclusive.
  startPeriod   Int
  endPeriod     Int
  title         String
  attendees     Int
  priority      BookingPriority
  status        BookingStatus   @default(PENDING)
  /// Booked over classes with the Head of Institute's override.
  classOverride Boolean         @default(false)
  requestedBy   String
  decidedBy     String?
  decidedAt     DateTime?
  note          String?
  createdAt     DateTime        @default(now())

  @@index([institutionId, date])
  @@index([institutionId, status])
}

// ---------------------------------------------------------------- Office hours & appointments

/// A teacher's weekly office hours (free periods of the timetable) and booking settings.
model OfficeHours {
  id             String      @id @default(cuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teacherId      String      @unique
  /// [dayIndex, period] pairs on the weekly timetable.
  slots          Json        @default("[]")
  slotMinutes    Int         @default(15)
  perStudentWeek Int         @default(2)
  location       String      @default("")
  updatedAt      DateTime    @updatedAt
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  /// The slot stopped being free (new timetable, leave, cover duty); both sides were told.
  INVALID
}

model Appointment {
  id            String            @id @default(cuid())
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teacherId     String
  /// The student's user id.
  studentId     String
  date          DateTime          @db.Date
  period        Int
  /// Minutes after the period starts.
  offset        Int
  minutes       Int
  topic         String
  status        AppointmentStatus @default(BOOKED)
  note          String?
  createdAt     DateTime          @default(now())

  @@index([institutionId, teacherId, date])
  @@index([institutionId, studentId])
}

// ---------------------------------------------------------------- Placement drives

model PlacementDrive {
  id            String           @id @default(cuid())
  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  company       String
  role          String           @default("")
  notes         String           @default("")
  /// [{ sectionId, count }]: students from each section taking part.
  attending     Json             @default("[]")
  /// [{ roll, sectionId }] when the list came from pasted roll numbers.
  rolls         Json             @default("[]")
  createdBy     String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  rounds        PlacementRound[]

  @@index([institutionId])
}

/// One round (test, interview...) on a date for a run of periods; its venue is requested
/// as a Placement-priority booking.
model PlacementRound {
  id          String         @id @default(cuid())
  driveId     String
  drive       PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  name        String
  date        DateTime       @db.Date
  startPeriod Int
  endPeriod   Int
  roomId      String?
  bookingId   String?

  @@index([driveId])
}

// ---------------------------------------------------------------- Elective registration

/// When students of a basket's sections may choose their elective, and seats per elective.
model ElectiveWindow {
  id            String         @id @default(cuid())
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  basketId      String         @unique
  basket        ElectiveBasket @relation(fields: [basketId], references: [id], onDelete: Cascade)
  opensOn       DateTime       @db.Date
  closesOn      DateTime       @db.Date
  /// { offeringId: seat limit }
  seats         Json           @default("{}")
  /// When the counts were last copied into the electives' class sizes.
  appliedAt     DateTime?
  createdBy     String
  updatedAt     DateTime       @updatedAt
}

/// One student's elective in a basket (one per basket).
model ElectiveChoice {
  id            String         @id @default(cuid())
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  basketId      String
  basket        ElectiveBasket @relation(fields: [basketId], references: [id], onDelete: Cascade)
  offeringId    String
  /// The student's user id.
  studentId     String
  sectionId     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([basketId, studentId])
  @@index([basketId, offeringId])
}

// ---------------------------------------------------------------- Lab downtime

/// A room out of service for a date range (all day, or some periods).
model RoomDowntime {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromDate      DateTime    @db.Date
  toDate        DateTime    @db.Date
  /// 0-based periods; empty = the whole day.
  periods       Json        @default("[]")
  reason        String
  createdBy     String
  createdAt     DateTime    @default(now())

  @@index([institutionId, toDate])
}

/// A class held in another room on one date (its usual room is out of service).
model RoomMove {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  date          DateTime    @db.Date
  versionId     String
  lessonId      String
  roomId        String
  createdBy     String
  createdAt     DateTime    @default(now())

  @@unique([institutionId, date, lessonId])
  @@index([institutionId, date])
}

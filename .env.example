# Copy to .env and fill in. Never commit .env.

# Local: create the database first, e.g.  createdb -U postgres timetable
# Production: the Neon connection string (use the pooled URL on Vercel).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/timetable"


# Copy to .env and fill in. Never commit .env.

# Local development database (create it first, e.g.  createdb -U postgres timetable)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/timetable"

# Production (Neon). Used only by `npm run db:prod -- <command>`; on Vercel set it as DATABASE_URL.
PROD_DB_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require"

# Login (Better Auth). Required in production; generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The app's public URL (http://localhost:3000 locally, your Vercel URL in production).
BETTER_AUTH_URL="http://localhost:3000"

# Optional "Continue with Google": create OAuth credentials in Google Cloud Console with the
# redirect URI  <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Optional AI fallback for plain-English rules. Server-only; never exposed to the browser.
# A built-in reader handles most rules for free; the AI is called only when it can't and the
# admin clicks "Ask ...". Answers are cached per sentence and capped at 30 calls/college/day.
# LLM_PROVIDER picks one: "anthropic" (Claude) or "xai" (Grok). If unset, whichever key is present.
# LLM_PROVIDER="anthropic"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"   # e.g. claude-haiku-5-5 is cheaper
# XAI_API_KEY=""
# XAI_MODEL="grok-4.20-0309-non-reasoning"
